# Database
DATABASE_URL="postgresql://qaflow_user:qaflow_password@localhost:5432/qaflow_dev?schema=public"
DIRECT_URL="postgresql://qaflow_user:qaflow_password@localhost:5432/qaflow_dev?schema=public"

# Auth.js. Generate a real value outside Git.
AUTH_SECRET="replace-with-secure-random-value"
AUTH_TRUST_HOST="true"

# Optional GitHub OAuth provider placeholders for local development.
# Create real values in GitHub Developer Settings and keep them outside Git.
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# Public app URL used by auth callbacks and future integrations.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
